{
  "name": "kds-frontend",
  "version": "1.0.12",
  "description": "Kitchen Display System - Electron + React",
  "main": "dist-electron/main.js",
  "author": "Nz-Dev-Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nz-dev-lab/coco-kds-releases"
  },
  "scripts": {
    "dev": "npm run build:electron && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "cross-env VITE_APP_VERSION=$npm_package_version vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "cross-env NODE_ENV=production VITE_APP_VERSION=$npm_package_version tsc && vite build && npm run build:electron",
    "build:electron": "cross-env NODE_ENV=production tsc -p electron/tsconfig.json",
    "electron:build": "npm run build && cross-env NODE_ENV=production electron-builder --publish never",
    "preview": "vite preview"
  },
  "keywords": [],
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.3.9",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.545.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.1",
    "react-toastify": "^11.0.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^29.4.6",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.kds.kitchen-display-system",
    "productName": "Coco KDS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "dist/sounds",
        "to": "sounds",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.mp3",
      "**/*.wav",
      "**/*.ogg"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "deb": {
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
